{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "batch.schema.json",
  "title": "Batch",
  "type": "object",
  "required": ["id", "book", "chapter", "verses", "context", "glossary_version", "glossary", "config"],
  "properties": {
    "id": { "type": "string", "description": "e.g. LUK.22.b07" },
    "book": { "type": "string" },
    "chapter": { "type": "integer" },
    "state": {
      "enum": ["queued", "pretagged", "translating", "checking", "reviewing", "debating", "coordinating", "accepted", "escalated", "resolved", "failed"]
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "italics", "pretag", "mechanical"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/verse_id" },
          "text": { "type": "string", "description": "KJV 1769 text, unchanged" },
          "italics": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/span" } },
          "small_caps": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/span" } },
          "pretag": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "text", "tag"],
              "properties": {
                "start": { "type": "integer" },
                "end": { "type": "integer" },
                "text": { "type": "string" },
                "tag": { "enum": ["pronoun", "verb_form", "archaic", "shifted", "locked", "escalate_only", "glossary"] },
                "number": { "enum": ["sg", "pl", null] },
                "mandatory_update": { "type": ["string", "null"] },
                "glossary_id": { "type": ["string", "null"] }
              }
            }
          },
          "mechanical": {
            "type": "object",
            "required": ["text", "pronoun_marks"],
            "properties": {
              "text": { "type": "string" },
              "pronoun_marks": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/pronoun_mark" } }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["chapter_text"],
      "properties": {
        "chapter_text": { "type": "string" },
        "previous_accepted": {
          "type": "array",
          "maxItems": 2,
          "items": { "type": "object", "properties": { "batch_id": { "type": "string" }, "text": { "type": "string" } } }
        }
      }
    },
    "reference": {
      "type": "object",
      "description": "preloaded lookups for this batch (reference/REFERENCE.md); given only to agents with reference access",
      "properties": {
        "original": { "type": "object", "description": "verse_id -> lookup.original result" },
        "lexicon": { "type": "object", "description": "strongs -> lookup.lexicon result" },
        "english_1611": { "type": "object", "description": "headword -> lookup.english_1611 result, for pretagged and glossary tokens" }
      }
    },
    "glossary_version": { "type": "integer" },
    "glossary": { "type": "array", "items": { "$ref": "glossary-entry.schema.json" } },
    "config": {
      "type": "object",
      "properties": { "plural_you_style": { "enum": ["marker", "you_all", "none"] } }
    }
  }
}
