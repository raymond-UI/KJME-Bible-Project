{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate.schema.json",
  "title": "Candidate",
  "type": "object",
  "required": ["id", "batch_id", "author", "verses", "glossary_proposals"],
  "properties": {
    "id": { "type": "string" },
    "batch_id": { "type": "string" },
    "author": { "type": "string", "description": "agent name, or 'mechanical', or 'consistency-editor' for patches" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2, "description": "2 = after one repair" },
    "eligible": { "type": "boolean", "description": "set by the orchestrator after checks" },
    "verses": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/updated_verse" } },
    "glossary_proposals": { "type": "array", "items": { "$ref": "glossary-entry.schema.json" } },
    "notes": { "type": "string", "maxLength": 1000 }
  }
}
