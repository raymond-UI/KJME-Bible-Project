{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Translator output (agent-facing; offsets are computed by the harness)",
  "type": "object",
  "required": ["verses"],
  "properties": {
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "changes"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kjv", "update", "category", "reason"],
              "properties": {
                "kjv": { "type": "string" },
                "update": { "type": "string" },
                "category": { "enum": ["pronoun_sg", "pronoun_pl", "verb_form", "archaic_word", "shifted_meaning", "syntax", "spelling", "punctuation"] },
                "reason": { "type": "string" },
                "glossary_id": { "type": ["string", "null"] },
                "uncertain": { "type": "boolean" },
                "source": { "type": "string" },
                "evidence": {
                  "type": "array",
                  "items": { "type": "object", "properties": { "lookup_id": { "type": "string" }, "note": { "type": "string" } } }
                }
              }
            }
          }
        }
      }
    },
    "glossary_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kjv_form", "sense", "update", "category"],
        "properties": {
          "kjv_form": { "type": "string" }, "sense": { "type": "string" }, "update": { "type": "string" },
          "category": { "type": "string" }, "example": { "type": "string" }, "notes": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
