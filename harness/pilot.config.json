{
  "run_id": "pilot-php-001",
  "scope": {
    "books": [
      "PHP"
    ],
    "chapters": null
  },
  "batch": {
    "split_on": "paragraph",
    "min_verses": 2,
    "max_verses": 6
  },
  "plural_you_style": "marker",
  "inference": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "routing": {
        "allow_fallbacks": false,
        "data_collection": "deny",
        "require_parameters": true
      },
      "structured_output": "json_schema_if_supported",
      "log_served_provider": true
    },
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1",
      "api_key_env": "ANTHROPIC_API_KEY",
      "api": "messages",
      "structured_output": "json_schema",
      "prompt_caching": {
        "enabled": true,
        "cache_prefix": "system",
        "ttl": "5m"
      },
      "batch_api": {
        "enabled": false,
        "note": "true halves cost; switches review and coordination to wave mode (PIPELINE.md, Waves)"
      }
    }
  },
  "agents": {
    "translator-minimalist": {
      "gateway": "openrouter",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "temperature": 0.2,
      "needs_tools": true,
      "max_tokens": 24000,
      "reasoning": {
        "effort": "medium"
      }
    },
    "translator-clarity": {
      "gateway": "openrouter",
      "model": "minimax/minimax-m3.1-flash",
      "temperature": 0.4,
      "needs_tools": true,
      "max_tokens": 24000,
      "reasoning": {
        "effort": "medium"
      }
    },
    "translator-cadence": {
      "gateway": "openrouter",
      "model": "inclusionai/ling-3.0-flash",
      "temperature": 0.5,
      "needs_tools": true,
      "max_tokens": 24000,
      "reasoning": {
        "effort": "medium"
      }
    },
    "reviewer-scorer": {
      "gateway": "openrouter",
      "model": "minimax/minimax-m3.1-flash",
      "temperature": 0.0,
      "needs_tools": false,
      "max_tokens": 16000,
      "reasoning": {
        "effort": "low"
      },
      "json_mode": true,
      "fallback_model": "deepseek/deepseek-v4.1-flash-1017"
    },
    "reviewer-meaning-auditor": {
      "gateway": "anthropic",
      "model": "claude-opus-5-5",
      "temperature": 0.0,
      "needs_tools": true,
      "max_tokens": 12000
    },
    "coordinator": {
      "gateway": "anthropic",
      "model": "claude-opus-5-5",
      "temperature": 0.0,
      "needs_tools": true,
      "max_tokens": 12000
    },
    "consistency-editor": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.0,
      "needs_tools": true,
      "max_prompt_tokens": 100000,
      "max_tokens": 6000
    }
  },
  "model_rules": {
    "translators_distinct_families": true,
    "auditor_family_differs_from_translators": true
  },
  "reference": {
    "path": "reference/data",
    "agent_network": false,
    "max_lookups_per_agent_per_batch": 8,
    "access": [
      "translator-minimalist",
      "translator-clarity",
      "translator-cadence",
      "reviewer-meaning-auditor",
      "coordinator",
      "consistency-editor"
    ]
  },
  "agent_retries": 2,
  "repair_attempts": 1,
  "debate_rounds": 1,
  "parallel_batches": 2,
  "escalation": {
    "score_gap": 0.05,
    "min_confidence": 0.7
  },
  "glossary": {
    "seed": "data/glossary.seed.json",
    "ratify_after_uses": 3
  },
  "skip_agents_when_mechanical_complete": false,
  "budget": {
    "max_usd": 25,
    "currency": "USD"
  },
  "agents_feedback": {
    "feedback-triage": {
      "gateway": "openrouter",
      "model": "minimax/minimax-m3.1-flash",
      "temperature": 0.0,
      "needs_tools": false,
      "schedule": "daily"
    }
  },
  "release": {
    "edition": "King James Margin Edition",
    "abbreviation": "KJME",
    "version": "0.1",
    "publisher": "Mzed Studio",
    "editors": [
      "Raymond Asogwa"
    ],
    "plain_style": "marker",
    "formats": [
      "usfm",
      "json",
      "plain"
    ],
    "license": {
      "text": "CC-BY-4.0",
      "record": "CC-BY-4.0",
      "system": "MIT"
    },
    "statement": "PUBLISHING.md#how-this-edition-was-made"
  },
  "replay_cache": true
}