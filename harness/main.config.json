{
  "run_id": "main-001",
  "scope": {
    "books": [],
    "chapters": null,
    "note": "Set per run with --book and --chapters, and name each run with --run. The main work goes in many small runs, with quality control between them."
  },
  "batch": {
    "split_on": "paragraph",
    "min_verses": 2,
    "max_verses": 6
  },
  "plural_you_style": "marker",
  "inference": {
    "anthropic": {
      "base_url": "https://api.anthropic.com/v1",
      "api_key_env": "ANTHROPIC_API_KEY",
      "api": "messages",
      "structured_output": "json_schema",
      "prompt_caching": {
        "enabled": true,
        "cache_prefix": "system",
        "ttl": "5m"
      },
      "batch_api": {
        "enabled": false,
        "note": "true halves cost; switches review and coordination to wave mode (PIPELINE.md, Waves)"
      }
    }
  },
  "agents": {
    "translator-minimalist": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.2,
      "needs_tools": true,
      "max_tokens": 24000,
      "reasoning": {
        "effort": "medium"
      }
    },
    "translator-clarity": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.4,
      "needs_tools": true,
      "max_tokens": 24000,
      "reasoning": {
        "effort": "medium"
      }
    },
    "translator-cadence": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.5,
      "needs_tools": true,
      "max_tokens": 24000,
      "reasoning": {
        "effort": "medium"
      }
    },
    "reviewer-scorer": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.0,
      "needs_tools": false,
      "max_tokens": 16000,
      "reasoning": {
        "effort": "low"
      },
      "json_mode": true
    },
    "reviewer-meaning-auditor": {
      "gateway": "anthropic",
      "model": "claude-opus-5-5",
      "temperature": 0.0,
      "needs_tools": true,
      "max_tokens": 12000
    },
    "coordinator": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.0,
      "needs_tools": true,
      "max_tokens": 12000
    },
    "consistency-editor": {
      "gateway": "anthropic",
      "model": "claude-haiku-5-5",
      "temperature": 0.0,
      "needs_tools": true,
      "max_prompt_tokens": 100000,
      "max_tokens": 6000
    }
  },
  "model_rules": {
    "translators_distinct_families": false,
    "auditor_family_differs_from_translators": false,
    "note": "Single Anthropic family by choice: Haiku 5.5 for translators, scorer, coordinator and consistency editor; Opus 5.5 for the meaning auditor. The Haiku team beat the mixed team 7-5 in the blind Philippians comparison."
  },
  "reference": {
    "path": "reference/data",
    "agent_network": false,
    "max_lookups_per_agent_per_batch": 8,
    "access": [
      "translator-minimalist",
      "translator-clarity",
      "translator-cadence",
      "reviewer-meaning-auditor",
      "coordinator",
      "consistency-editor"
    ]
  },
  "agent_retries": 2,
  "repair_attempts": 1,
  "debate_rounds": 1,
  "debate_skip_clear_auditor": true,
  "parallel_batches": 2,
  "max_consecutive_failures": 3,
  "escalation": {
    "score_gap": 0.05,
    "min_confidence": 0.7
  },
  "glossary": {
    "seed": "data/glossary.seed.json",
    "ratify_after_uses": 3,
    "path": "runs/main-glossary.json",
    "note": "Shared by every main run, so rulings carry from one run to the next."
  },
  "skip_agents_when_mechanical_complete": false,
  "budget": {
    "max_usd": 25,
    "currency": "USD",
    "note": "Per run. Philippians (104 verses) cost $8.32 on the subscription gateway's metering."
  },
  "release": {
    "edition": "King James Margin Edition",
    "abbreviation": "KJME",
    "version": "0.1",
    "publisher": "Raymond Asogwa",
    "editors": [
      "Raymond Asogwa"
    ],
    "plain_style": "marker",
    "formats": [
      "usfm",
      "json",
      "plain"
    ],
    "license": {
      "text": "CC-BY-4.0",
      "record": "CC-BY-4.0",
      "system": "MIT"
    },
    "statement": "PUBLISHING.md#how-this-edition-was-made"
  },
  "replay_cache": true
}
